# Supabase → Project Settings → API. Sans ces variables, l'app démarre en mode démo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paiement en ligne (facultatif). Sans ces trois clés, seul le paiement au comptoir est proposé.
# Stripe → Developers → API keys (clé secrète) et Webhooks (secret de signature).
# Supabase → Project Settings → API → service_role (ne jamais l'exposer côté navigateur).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
